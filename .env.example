# Paths (defaults point at ./data)
POLICIES_PATH=./data/policies.md
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/shopsphere.db
# Date treated as "today" for all business rules (never the machine clock)
APP_TODAY=2026-07-01
# LLM: Groq (OpenAI-compatible API). Put your own key here, never commit it.
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
# Optional
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=20
TOTAL_BUDGET_SECONDS=26
MAX_TOOL_CALLS=6
